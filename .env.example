# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=sterragency.com,www.sterragency.com
CSRF_TRUSTED_ORIGINS=https://sterragency.com,https://www.sterragency.com
# Canonical origin, no trailing slash (used in canonical/sitemap/OG)
SITE_URL=https://sterragency.com
# Optional locally (default: SQLite db.sqlite3). Required on Render: Supabase
# "Session pooler" string, e.g.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Media storage (required on Render unless a persistent disk is attached) ---
# Supabase Storage (S3 compatible). Leave AWS_STORAGE_BUCKET_NAME empty to use local media/.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# https://<ref>.supabase.co/storage/v1/s3
AWS_S3_ENDPOINT_URL=
# Supabase project region, e.g. eu-central-1
AWS_S3_REGION_NAME=
# Public URL prefix without https://, e.g. <ref>.supabase.co/storage/v1/object/public/media
AWS_S3_CUSTOM_DOMAIN=
# Alternative to S3: Render persistent disk mounted at /var/data
# MEDIA_ROOT=/var/data/media

# --- First admin user (created on deploy if missing; password never overwritten) ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Resend (new account) ---
# 1) resend.com → Domains → add & verify your domain  2) API Keys → create key
RESEND_API_KEY=
# Must be on the verified Resend domain
DEFAULT_FROM_EMAIL=Sterr Agency <noreply@sterragency.com>
# Who gets the "yeni lead geldi" email (comma-separated)
LEAD_NOTIFY_EMAILS=you@example.com

# --- Contact ---
WHATSAPP_NUMBER=905414487561
WHATSAPP_DISPLAY=+90 541 448 75 61
CONTACT_EMAIL=hello@sterragency.com

# --- Analytics (optional, leave blank to disable) — see ANALYTICS.md ---
# GA4 Measurement ID (G-XXXXXXX). If GTM_ID is also set, GA4 is expected to live
# inside GTM and gtag.js is not loaded directly (avoids double counting).
GA4_ID=
# GA4 → Admin → Data streams → (stream) → Measurement Protocol API secrets
# Sends admin lead status changes (qualify_lead, close_convert_lead…) to GA4.
GA4_API_SECRET=
GTM_ID=
META_PIXEL_ID=
GOOGLE_SITE_VERIFICATION=
